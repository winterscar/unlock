;; unlock services, EDN form. The nix module writes the same shape as JSON to
;; /etc/unlock/services.json; this file is for --dry-run and development.
;;
;; Per service:
;;   :allow-hosts   host globs the service may be unlocked against; * is one DNS label
;;   :deny-hosts    host globs that are refused even if allowed
;;   :default-host  used when `unlock <service>` is given no host
;;   :scheme        "https" (default) or "http"
;;   :auth          what to inject. {host} in a reference is replaced by the host.
;;                  {:type :bearer :token "op://..."}
;;                  {:type :basic  :username "op://..." :password "op://..."}
;;                  {:type :header :name "X-Api-Key" :value "op://..." :format "{}"}
;;                  {:type :login  :username "op://..." :password "op://..."
;;                   :login-path "/auth"        ; Basic credentials sent here...
;;                   :login-method :get         ; default :get
;;                   :token-field "token"       ; ...Bearer token read from here (dotted path)
;;                   :exp-field "exp"}          ; optional unix-seconds expiry
;;   :allow         optional [method path-glob] rules, e.g. [[:get "/api/**"]];
;;                  omit to allow every method and path.

{:op-bin "/usr/local/bin/op"

 :services
 {:example
  {:allow-hosts  ["*.example.com"]
   :deny-hosts   ["prod.example.com"]
   :default-host "dev.example.com"
   :auth {:type       :login
          :login-path "/auth/login"
          :username   "op://Private/Example dev/username"
          :password   "op://Private/Example dev/password"}
   :allow [[:get "/api/**"]]}}}
